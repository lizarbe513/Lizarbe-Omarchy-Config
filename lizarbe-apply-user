#!/usr/bin/env bash
# ==============================================================================
# lizarbe-apply-user: Aplica el tema Lizarbe, dotfiles y corrige Bloq Mayús
# Puede ejecutarse directamente por el usuario o mediante sudo/root indicando el usuario.
# ==============================================================================
set -e

# Detectar usuario objetivo
TARGET_USER="${1:-$USER}"
if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
    if [[ -n "$SUDO_USER" && "$SUDO_USER" != "root" ]]; then
        TARGET_USER="$SUDO_USER"
    elif [[ -n "$OMARCHY_INSTALL_USER" && "$OMARCHY_INSTALL_USER" != "root" ]]; then
        TARGET_USER="$OMARCHY_INSTALL_USER"
    else
        # Buscar el primer usuario con UID >= 1000 en /home
        FIRST_USER=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' /etc/passwd 2>/dev/null || true)
        if [[ -n "$FIRST_USER" ]]; then
            TARGET_USER="$FIRST_USER"
        else
            TARGET_USER="root"
        fi
    fi
fi

USER_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6 2>/dev/null || echo "/home/$TARGET_USER")
if [[ ! -d "$USER_HOME" ]]; then
    mkdir -p "$USER_HOME"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# En desarrollo (desde el código fuente) usa las carpetas de al lado; instalado
# desde el paquete usa /usr/share (lizarbe-tema).
THEME_SRC="$SCRIPT_DIR"

# 1. Enlaces de iconos Lizarbe-Red
mkdir -p "$USER_HOME/.local/share/icons" "$USER_HOME/.icons"
if [[ -d "$THEME_SRC/icons/Lizarbe-Red" ]]; then
    ln -sfn "$THEME_SRC/icons/Lizarbe-Red" "$USER_HOME/.local/share/icons/Lizarbe-Red"
    ln -sfn "$THEME_SRC/icons/Lizarbe-Red" "$USER_HOME/.icons/Lizarbe-Red"
elif [[ -d "/usr/share/icons/Lizarbe-Red" ]]; then
    ln -sfn "/usr/share/icons/Lizarbe-Red" "$USER_HOME/.local/share/icons/Lizarbe-Red"
    ln -sfn "/usr/share/icons/Lizarbe-Red" "$USER_HOME/.icons/Lizarbe-Red"
fi
if [[ -d "$USER_HOME/Projects" ]] && command -v gio &>/dev/null; then
    gio set -t string "$USER_HOME/Projects" metadata::custom-icon-name folder-projects 2>/dev/null || true
fi

# 2. Enlaces de los temas Lizarbe (oscuro, claro y arena) para desarrollo y reactividad local
mkdir -p "$USER_HOME/.config/omarchy/themes"
for t in lizarbe lizarbe-light lizarbe-arena; do
    if [[ -d "$THEME_SRC/config/omarchy/themes/$t" ]]; then
        ln -sfn "$THEME_SRC/config/omarchy/themes/$t" "$USER_HOME/.config/omarchy/themes/$t"
    fi
done

# 3. Enlaces del tema GTK Darky
mkdir -p "$USER_HOME/.local/share/themes"
if [[ -d "/usr/share/themes/Darky" ]]; then
    ln -sfn "/usr/share/themes/Darky" "$USER_HOME/.local/share/themes/Darky"
fi

# Limpiar enlaces estáticos en gtk-4.0 si apuntan a Darky para permitir la reactividad nativa de Omarchy
GTK4_USER_DIR="$USER_HOME/.config/gtk-4.0"
for f in "$GTK4_USER_DIR/gtk.css" "$GTK4_USER_DIR/gtk-dark.css" "$GTK4_USER_DIR/assets"; do
    if [[ -L "$f" && "$(readlink -f "$f" 2>/dev/null)" == *Darky* ]]; then
        rm -f "$f"
    fi
done

# 4. Configuración de Fastfetch
mkdir -p "$USER_HOME/.config/fastfetch"
if [[ -d "$THEME_SRC/config/fastfetch" ]]; then
    cp -r "$THEME_SRC/config/fastfetch/"* "$USER_HOME/.config/fastfetch/" 2>/dev/null || true
elif [[ -d "/etc/xdg/fastfetch" ]]; then
    cp -r /etc/xdg/fastfetch/* "$USER_HOME/.config/fastfetch/" 2>/dev/null || true
fi

# 5. Configuración de Starship
mkdir -p "$USER_HOME/.config"
if [[ -f "$THEME_SRC/config/starship.toml" ]]; then
    cp -f "$THEME_SRC/config/starship.toml" "$USER_HOME/.config/starship.toml"
elif [[ -f "/etc/starship.toml" ]]; then
    cp -f "/etc/starship.toml" "$USER_HOME/.config/starship.toml"
fi

# 6. Branding de Omarchy
if [[ -d "$THEME_SRC/config/omarchy/branding" ]]; then
    mkdir -p "$USER_HOME/.config/omarchy/branding"
    cp -r "$THEME_SRC/config/omarchy/branding/"* "$USER_HOME/.config/omarchy/branding/" 2>/dev/null || true
elif [[ -d "/usr/share/omarchy/branding" ]]; then
    mkdir -p "$USER_HOME/.config/omarchy/branding"
    cp -r /usr/share/omarchy/branding/* "$USER_HOME/.config/omarchy/branding/" 2>/dev/null || true
fi

# 7. Las reglas de ventana flotante las gestiona lizarbe-doctor (paquete lizarbe-menu);
# la tecla Compose/Bloq Mayús se configura en Escritorio > Teclado.

# 8. Activar el tema Lizarbe a través de Omarchy
export OMARCHY_THEME_HEADLESS=1
TARGET_THEME="${2:-}"
if [[ -z "$TARGET_THEME" ]]; then
    CURRENT_THEME=$(omarchy theme current 2>/dev/null || echo "")
    if [[ "$CURRENT_THEME" == "lizarbe-light" ]]; then
        TARGET_THEME="lizarbe-light"
    else
        TARGET_THEME="lizarbe"
    fi
fi

# Sanitizar nombre de tema para prevenir inyección de comandos
if [[ ! "$TARGET_THEME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "[ERROR] Nombre de tema inválido: $TARGET_THEME" >&2
    exit 1
fi

if command -v omarchy-theme-set &>/dev/null; then
    if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
        su - "$TARGET_USER" -c "OMARCHY_THEME_HEADLESS=1 omarchy-theme-set '$TARGET_THEME' || true" 2>/dev/null || true
    else
        omarchy-theme-set "$TARGET_THEME" 2>/dev/null || true
    fi
elif command -v omarchy &>/dev/null; then
    if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
        su - "$TARGET_USER" -c "omarchy theme set '$TARGET_THEME' || true" 2>/dev/null || true
    else
        omarchy theme set "$TARGET_THEME" 2>/dev/null || true
    fi
fi

# Asegurar propiedad de los archivos si se ejecutó como root
if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
    chown -R "$TARGET_USER:$TARGET_USER" "$USER_HOME/.config" "$USER_HOME/.local" "$USER_HOME/.icons" 2>/dev/null || true
fi

exit 0
