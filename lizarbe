#!/usr/bin/env bash
# ==============================================================================
# lizarbe: línea de comandos de Lizarbe (paquete lizarbe-centro)
# ==============================================================================
set -e

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

# Carpeta de la aplicación: la del paquete, o la de este script si se ejecuta
# desde el código fuente.
resolve_app_dir() {
    local source="${BASH_SOURCE[0]}" dir
    while [[ -h "$source" ]]; do
        dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
        source="$(readlink "$source")"
        [[ $source != /* ]] && source="$dir/$source"
    done
    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
    for candidate in "$dir" /usr/lib/lizarbe-centro; do
        if [[ -d "$candidate/lizarbe_tui" ]]; then
            echo "$candidate"
            return
        fi
    done
}
APP_DIR="$(resolve_app_dir)"

print_banner() {
    echo -e "${CYAN}"
    echo "=========================================================="
    echo "               CENTRO LIZARBE - LÍNEA DE COMANDOS         "
    echo "=========================================================="
    echo -e "${NC}"
}

need_app() {
    if [[ -z "$APP_DIR" || ! -f "$APP_DIR/$1" ]]; then
        echo -e "${RED}[ERROR]${NC} Falta $1. Instala el paquete: sudo pacman -S lizarbe-centro"
        exit 1
    fi
}

cmd_update() {
    print_banner
    echo -e "${CYAN}→${NC} Lizarbe se actualiza junto con el sistema (omarchy update)."
    if command -v omarchy-update &>/dev/null; then
        exec omarchy-update "$@"
    fi
    exec omarchy update "$@"
}

cmd_uninstall() {
    print_banner
    need_app uninstall.sh
    bash "$APP_DIR/uninstall.sh" "$@"
}

cmd_apply() {
    if command -v lizarbe-apply-user &>/dev/null; then
        lizarbe-apply-user "$@"
    else
        echo -e "${RED}[ERROR]${NC} No se encontró lizarbe-apply-user. Instala: sudo pacman -S lizarbe-tema"
        return 1
    fi
}

cmd_install() {
    print_banner
    need_app install.sh
    bash "$APP_DIR/install.sh" "$@"
}

cmd_status() {
    print_banner
    echo -e "${BOLD}Paquetes de Lizarbe:${NC}"
    echo "----------------------------------------------------------"
    local line name ver latest
    while read -r name ver; do
        latest=$(pacman -Si "$name" 2>/dev/null | awk -F': *' '$1 ~ /^Version/ {print $2; exit}')
        if [[ -n "$latest" && "$latest" != "$ver" ]]; then
            echo -e "  $name  ${GREEN}$ver${NC}  ${YELLOW}(disponible: $latest)${NC}"
        else
            echo -e "  $name  ${GREEN}$ver${NC}"
        fi
    done < <(pacman -Q 2>/dev/null | awk '$1 ~ /^lizarbe(-|$)/')
    echo "  (para actualizar: lizarbe update)"

    echo ""
    echo -e "${BOLD}Entorno Omarchy:${NC}"
    echo "----------------------------------------------------------"
    if command -v omarchy-theme-current &>/dev/null; then
        echo -e "  Tema activo     : $(omarchy-theme-current 2>/dev/null || echo 'desconocido')"
    fi
    [[ -d /usr/share/icons/Lizarbe-Red ]] && echo -e "  Iconos          : ${GREEN}Lizarbe-Red${NC}" || echo -e "  Iconos          : ${YELLOW}no encontrados${NC}"
    [[ -d /usr/share/themes/Darky ]] && echo -e "  Tema GTK        : ${GREEN}Darky${NC}" || echo -e "  Tema GTK        : ${YELLOW}no encontrado${NC}"
    echo "----------------------------------------------------------"
}

cmd_tui() {
    if [[ -n "$APP_DIR" ]] && command -v python3 &>/dev/null; then
        export PYTHONPATH="$APP_DIR:${PYTHONPATH:-}"
        exec python3 -m lizarbe_tui.cli "$@"
    fi
    show_help
}

show_help() {
    print_banner
    echo -e "${BOLD}USO:${NC}"
    echo "  lizarbe [comando] [opciones]"
    echo ""
    echo -e "${BOLD}COMANDOS DISPONIBLES:${NC}"
    echo -e "  ${CYAN}(sin argumentos)${NC} / ${CYAN}tui${NC}  Abre la interfaz interactiva TUI de Lizarbe"
    echo -e "  ${CYAN}update${NC}                  Actualiza el sistema y Lizarbe (omarchy update)"
    echo -e "  ${CYAN}uninstall${NC} (o ${CYAN}unistall${NC}) Desinstala componentes del tema o suites de software"
    echo -e "                          Opciones: --all, --apps-only, --theme-only, --help"
    echo -e "  ${CYAN}apply${NC}                   Aplica configuraciones, dotfiles, iconos y recarga el tema"
    echo -e "  ${CYAN}status${NC}                  Muestra las versiones de los paquetes de Lizarbe"
    echo -e "  ${CYAN}install${NC}                 Ejecuta el asistente de instalación de Lizarbe"
    echo -e "  ${CYAN}help${NC}                    Muestra esta ayuda"
    echo ""
    echo -e "${BOLD}EJEMPLOS:${NC}"
    echo "  lizarbe                  # Abre el panel TUI interactivo"
    echo "  lizarbe update"
    echo "  lizarbe apply"
    echo "  lizarbe status"
    echo "  lizarbe uninstall --theme-only"
    echo ""
}

# Enrutador principal de comandos
main() {
    if [[ $# -eq 0 ]]; then
        cmd_tui
        exit 0
    fi

    local action="$1"
    shift

    case "$action" in
        tui|--tui)
            cmd_tui "$@"
            ;;
        --section|-v|--version)
            cmd_tui "$action" "$@"
            ;;
        update|upgrade)
            cmd_update "$@"
            ;;
        uninstall|unistall|remove)
            cmd_uninstall "$@"
            ;;
        apply|apply-user)
            cmd_apply "$@"
            ;;
        status|info)
            cmd_status "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo -e "${RED}[ERROR]${NC} Comando desconocido: $action"
            echo "Ejecuta 'lizarbe help' para ver la lista de comandos disponibles."
            exit 1
            ;;
    esac
}

main "$@"
